{
  "manifestVersion": 5,
  "id": "pea-sync-local-dev",
  "name": "PEA Sync Local",
  "version": "0.2.0",
  "main": "index.html",
  "host": { "app": "premierepro", "minVersion": "25.6.0" },
  "entrypoints": [{
    "type": "panel", "id": "pea-sync", "label": { "default": "PEA Sync" },
    "minimumSize": { "width": 320, "height": 420 },
    "preferredDockedSize": { "width": 390, "height": 700 }
  }],
  "requiredPermissions": { "localFileSystem": "request" }
}
