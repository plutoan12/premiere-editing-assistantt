{
  "manifestVersion": 5,
  "id": "com.plutoan12.premiere-editing-assistant",
  "name": "Premiere Editing Assistant",
  "version": "0.1.0",
  "main": "index.html",
  "host": { "app": "premierepro", "minVersion": "25.6.0" },
  "requiredPermissions": {
    "localFileSystem": "request",
    "network": { "domains": ["https://127.0.0.1", "https://localhost"] }
  },
  "entrypoints": [{
    "type": "panel",
    "id": "pea-main",
    "label": { "default": "Premiere Editing Assistant" },
    "minimumSize": { "width": 320, "height": 360 },
    "preferredDockedSize": { "width": 380, "height": 520 },
    "preferredFloatingSize": { "width": 420, "height": 600 }
  }]
}
