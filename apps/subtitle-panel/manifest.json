{
  "manifestVersion": 5,
  "id": "com.plutoan12.premiere-editing-assistant.subtitle",
  "name": "Editing Assistant · Subtitle",
  "version": "0.1.0",
  "main": "index.html",
  "host": { "app": "premierepro", "minVersion": "25.6.0" },
  "requiredPermissions": {
    "localFileSystem": "request",
    "network": { "domains": ["https://127.0.0.1", "https://localhost", "https://[::1]"] }
  },
  "entrypoints": [{
    "type": "panel",
    "id": "pea-subtitle",
    "label": { "default": "Subtitle" },
    "minimumSize": { "width": 340, "height": 420 },
    "preferredDockedSize": { "width": 420, "height": 780 },
    "preferredFloatingSize": { "width": 480, "height": 860 }
  }]
}
