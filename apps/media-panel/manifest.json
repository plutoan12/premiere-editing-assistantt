{
  "manifestVersion": 5,
  "id": "local.pea.media.organizer.dev",
  "name": "Editing Assistant · Media Organizer",
  "version": "0.1.0",
  "main": "index.html",
  "host": [{ "app": "premierepro", "minVersion": "26.5.0" }],
  "entrypoints": [
    {
      "type": "panel",
      "id": "mediaOrganizer",
      "label": { "default": "Media Organizer" },
      "minimumSize": { "width": 360, "height": 440 },
      "preferredDockedSize": { "width": 560, "height": 740 },
      "preferredFloatingSize": { "width": 680, "height": 820 }
    }
  ],
  "requiredPermissions": {
    "localFileSystem": "request",
    "network": { "domains": ["http://localhost"] }
  }
}
