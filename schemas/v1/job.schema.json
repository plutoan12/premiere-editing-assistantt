              "itemId": {
                "type": "string",
                "minLength": 1
              },
              "status": {
                "type": "string",
                "const": "succeeded"
              }
            },
            "required": [
              "itemId",
              "status"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
