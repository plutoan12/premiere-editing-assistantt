# Copy to .env (git-ignored). Never commit real values.
# Provider credentials are read by provider implementations only; Core and
# engines never see them. Leave a key empty to disable that provider.

# Speech-to-text provider
PEA_STT_PROVIDER=
PEA_STT_API_KEY=

# LLM provider (semantic tagging, selects, rough-cut reasoning, translation)
PEA_LLM_PROVIDER=
PEA_LLM_API_KEY=

# Vision provider (scene / person tagging)
PEA_VISION_PROVIDER=
PEA_VISION_API_KEY=

# Translation provider (optional; falls back to the LLM provider)
PEA_TRANSLATION_PROVIDER=
PEA_TRANSLATION_API_KEY=

# Local artifact store root (defaults to ./.pea/artifacts)
PEA_ARTIFACT_ROOT=

# Optional per-project AI budget guard in USD; empty disables the guard
PEA_AI_BUDGET_USD=
