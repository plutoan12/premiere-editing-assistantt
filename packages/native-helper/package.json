{
  "name": "@pea/native-helper",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22" },
  "exports": { ".": "./src/index.ts" },
  "scripts": {
    "test": "vitest run --exclude 'src/**/*.integration.test.ts'",
    "test:integration": "vitest run src/*.integration.test.ts",
    "typecheck": "tsc --noEmit",
    "build": "node build.mjs",
    "start": "node dist/pea-helper.mjs",
    "smoke": "node scripts/smoke.mjs"
  },
  "dependencies": { "@pea/sync": "workspace:*" },
  "devDependencies": { "@types/node": "^22.18.0", "typescript": "^5.9.2", "vitest": "^3.2.4", "esbuild": "^0.25.9" }
}
